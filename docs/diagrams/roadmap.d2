# Roadmap: Version 1 milestones and Phase 2. Render: scripts/render-diagrams.sh
# One row per phase keeps the image narrow enough to read in a README.
grid-rows: 2
grid-gap: 60

v1: "Version 1 (done)" {
  direction: right
  m0: "M0\nbootstrap\nCMake · CI · Docker Postgres"
  m1: "M1\nstate model\nin-memory store · leases"
  m2: "M2\ncoordinator + gRPC\nworkers pull, renew, report"
  m3: "M3\nPostgreSQL\ndurable state · SKIP LOCKED"
  m4: "M4\nfencing · idempotency\nUNKNOWN · fault injection"
  m5: "M5\nDocker demo\nchaos benchmark"
  m0 -> m1 -> m2 -> m3 -> m4 -> m5
}

p2: "Phase 2" {
  direction: right
  p0: "P0 (done)\nconfirmation required\nbefore success (I8)"
  p1: "P1 (done)\natomic job + operation\nreconciliation · benchmark matrix"
  p2x: "P2 (deferred)\ndecision trace\nAI example" {style.stroke-dash: 4}
  p0 -> p1 -> p2x
}

