{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "unit",
      "inherits": "dev",
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    }
  ]
}
